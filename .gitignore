.spec-workflow/
.tools/*.exe
.tools/*.obj
.tools/*.dll
.tools/*.png

# 系统与编辑器
.DS_Store
*.swp
.idea/
.vscode/

# 临时提交信息
commit-msg.tmp
*.tmp

# 本地开发记录：只在本机保留，不进仓库

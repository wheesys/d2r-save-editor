<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  应用清单：声明本程序需要以管理员身份运行。

  为什么需要：D2R 的存档放在 `%USERPROFILE%\Saved Games\Diablo II Resurrected`，
  这个目录在不少机器上受 Windows 安全中心的「受控文件夹访问」（勒索软件防护）保护，
  普通权限进程写不进去，表现为保存时报「拒绝访问 (os error 5)」。

  让普通用户去"把程序加入允许的应用"或"关掉勒索软件防护"是不现实的——用户遇到
  保存失败只会放弃。存档修改器需要管理员权限是这个品类的通行做法，所以直接声明
  UAC 提权，用户只需在弹窗上点「是」。

  清单要遵守 Windows 的 schema，否则启动会报「并行配置不正确」：
  - `assemblyIdentity` 必须有 `language`（缺了就会 sxs 报错，踩过）；
  - `Common-Controls v6` 的依赖**必须保留**，Tauri 的对话框 API 依赖它；
  - 不要加 `compatibility/supportedOS`——对本程序没有必要，多一处出错机会。
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
    type="win32"
    name="D2RSaveEditor"
    version="1.0.0.0"
    processorArchitecture="*"
    language="*"
  />
  <description>D2R 存档修改器</description>

  <!-- 请求管理员权限（每次启动会弹 UAC） -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- Tauri 的对话框 API 需要它，不能省 -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>

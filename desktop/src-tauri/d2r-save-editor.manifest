<!--
  Application manifest: request administrator privileges.

  WHY: Diablo II Resurrected stores saves under the user profile's Saved Games
  folder. On many machines that folder is protected by Windows Security's
  Controlled Folder Access (ransomware protection), so a non-elevated process
  cannot write there and saving fails with "Access is denied (os error 5)".
  Telling users to allowlist the app or disable that protection is unrealistic:
  users simply give up when saving fails. Save editors requesting administrator
  rights is standard for this category, so we declare UAC elevation and the user
  just clicks Yes once.

  HARD CONSTRAINTS (all of these were hit for real):

  1. This file MUST stay pure ASCII. Tauri rewrites the manifest into a .rc
     resource using the local ANSI codepage, but the manifest declares UTF-8.
     Any non-ASCII character (a Chinese description, for example) therefore
     lands as mismatched bytes and Windows rejects the whole manifest with
     SideBySide "activation context generation failed / invalid XML syntax".
     User visible Chinese text belongs in the UI, not in this manifest.

  2. XML comments must not contain two consecutive hyphens.

  3. The top level assemblyIdentity must NOT declare language="*". Windows
     rejects it with "the value * of attribute language in element
     assemblyIdentity is invalid" and the app will not start at all. The
     wildcard is only valid on the dependent Common Controls assembly below;
     the top level one is fine without a language attribute.

  The Common Controls v6 dependency is required by Tauri's dialog APIs.
  Do not drop it.
-->
<assembly
  xmlns="urn:schemas-microsoft-com:asm.v1"
  xmlns:asmv3="urn:schemas-microsoft-com:asm.v3"
  manifestVersion="1.0"
>
  <assemblyIdentity
    type="win32"
    name="D2RSaveEditor"
    version="1.0.0.0"
    processorArchitecture="*"
  />
  <description>D2R Save Editor</description>

  <!-- Ask for administrator rights; UAC is shown on every launch. -->
  <asmv3:trustInfo>
    <asmv3:security>
      <asmv3:requestedPrivileges>
        <asmv3:requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
      </asmv3:requestedPrivileges>
    </asmv3:security>
  </asmv3:trustInfo>

  <!-- Required by Tauri's dialog APIs. -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
